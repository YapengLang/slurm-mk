#!/usr/bin/env bash
# =============================================================================
# slurm_setup.sh  —  Generate a SLURM job script + create output/log folders
#
# USAGE:
#   bash slurm_setup.sh -j <job-name> -l <log-folder> -o <output-folder> [OPTIONS]
#
# REQUIRED:
#   -j  Job name
#   -l  Log/error folder base path
#   -o  Overall output folder base path
#
# OPTIONAL (override defaults):
#   -N  Nodes            (default: 1)
#   -n  Tasks            (default: 1)
#   -c  CPUs per task    (default: 34)
#   -m  Memory           (default: 300GB)
#   -t  Time             (default: 36:00:00)
#   -p  Partition        (default: general)
#   -a  Account          (default: YOUR_ACCOUNT)
#   -h  Show this help
# =============================================================================

set -euo pipefail

# ── Colour helpers ─────────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

info()    { echo -e "${CYAN}[INFO]${RESET}  $*"; }
success() { echo -e "${GREEN}[OK]${RESET}    $*"; }
warn()    { echo -e "${YELLOW}[WARN]${RESET}  $*"; }
error()   { echo -e "${RED}[ERROR]${RESET} $*" >&2; exit 1; }

# ── Date stamp ─────────────────────────────────────────────────────────────────
DATE=$(date +"%d-%m-%y")   # DD-MM-YY  (safe for folder/file names)

# ── Default SBATCH values ─────────────────────────────────────────────────────
DEF_NODES=1
DEF_TASKS=1
DEF_CPUS=34
DEF_MEM="300GB"
DEF_TIME="36:00:00"
DEF_PARTITION="general"
DEF_ACCOUNT="YOUR_ACCOUNT"

# ── Usage ──────────────────────────────────────────────────────────────────────
usage() {
  grep '^#' "$0" | grep -v '^#!/' | sed 's/^# \{0,2\}//'
  exit 0
}

# ── Parse arguments ───────────────────────────────────────────────────────────
JOB_NAME=""
LOG_BASE=""
OUT_BASE=""
NODES=$DEF_NODES
TASKS=$DEF_TASKS
CPUS=$DEF_CPUS
MEM=$DEF_MEM
TIME=$DEF_TIME
PARTITION=$DEF_PARTITION
ACCOUNT=$DEF_ACCOUNT

while getopts ":j:l:o:N:n:c:m:t:p:a:h" opt; do
  case $opt in
    j) JOB_NAME="$OPTARG"    ;;
    l) LOG_BASE="$OPTARG"    ;;
    o) OUT_BASE="$OPTARG"    ;;
    N) NODES="$OPTARG"       ;;
    n) TASKS="$OPTARG"       ;;
    c) CPUS="$OPTARG"        ;;
    m) MEM="$OPTARG"         ;;
    t) TIME="$OPTARG"        ;;
    p) PARTITION="$OPTARG"   ;;
    a) ACCOUNT="$OPTARG"     ;;
    h) usage                 ;;
    :) error "Option -$OPTARG requires an argument." ;;
    \?) error "Unknown option: -$OPTARG" ;;
  esac
done

# ── Validate required args ────────────────────────────────────────────────────
[[ -z "$JOB_NAME" ]]  && error "Job name (-j) is required."
[[ -z "$LOG_BASE" ]]  && error "Log/error folder (-l) is required."
[[ -z "$OUT_BASE" ]]  && error "Output folder (-o) is required."

# ── Sanitise job name (no spaces) ────────────────────────────────────────────
JOB_NAME="${JOB_NAME// /_}"

# ── Stamped names ─────────────────────────────────────────────────────────────
STAMP="${JOB_NAME}_${DATE}"
SCRIPT_FILE="${STAMP}.sh"
LOG_DIR="${LOG_BASE}/${STAMP}"
OUT_DIR="${OUT_BASE}/${STAMP}"

# ── Banner ────────────────────────────────────────────────────────────────────
echo ""
echo -e "${BOLD}========================================${RESET}"
echo -e "${BOLD}  SLURM Job Setup  —  ${STAMP}${RESET}"
echo -e "${BOLD}========================================${RESET}"
echo ""

# ── Create folders ────────────────────────────────────────────────────────────
for DIR in "$LOG_DIR" "$OUT_DIR"; do
  if [[ -d "$DIR" ]]; then
    warn "Folder already exists: $DIR"
  else
    mkdir -p "$DIR"
    success "Created folder: $DIR"
  fi
done

# ── Generate SLURM job script ─────────────────────────────────────────────────
if [[ -f "$SCRIPT_FILE" ]]; then
  warn "Script already exists: $SCRIPT_FILE  (skipping overwrite)"
else
  cat > "$SCRIPT_FILE" <<EOF
#!/bin/bash
#SBATCH --job-name=${STAMP}
#SBATCH -N ${NODES}
#SBATCH -n ${TASKS}
#SBATCH -c ${CPUS}
#SBATCH --mem=${MEM}
#SBATCH --time=${TIME}
#SBATCH --partition=${PARTITION}
#SBATCH --account=${ACCOUNT}
#SBATCH --output=${LOG_DIR}/%x_%j.out
#SBATCH --error=${LOG_DIR}/%x_%j.err

# ── Environment ───────────────────────────────────────────────────────────────
echo "Job started : \$(date)"
echo "Job ID      : \$SLURM_JOB_ID"
echo "Node        : \$SLURMD_NODENAME"
echo "Output dir  : ${OUT_DIR}"
echo ""

# ── Your commands below ───────────────────────────────────────────────────────



# ── Done ──────────────────────────────────────────────────────────────────────
echo ""
echo "Job finished: \$(date)"
EOF

  chmod +x "$SCRIPT_FILE"
  success "Generated job script: $SCRIPT_FILE"
fi

# ── Summary ───────────────────────────────────────────────────────────────────
echo ""
echo -e "${BOLD}── Summary ─────────────────────────────────${RESET}"
echo -e "  Script     : ${CYAN}${SCRIPT_FILE}${RESET}"
echo -e "  Log dir    : ${CYAN}${LOG_DIR}${RESET}"
echo -e "  Output dir : ${CYAN}${OUT_DIR}${RESET}"
echo -e "  Resources  : ${NODES}N / ${TASKS}n / ${CPUS}c / ${MEM} / ${TIME}"
echo -e "  Partition  : ${PARTITION}  |  Account: ${ACCOUNT}"
echo ""
echo -e "${BOLD}── To submit ───────────────────────────────${RESET}"
echo -e "  ${GREEN}sbatch ${SCRIPT_FILE}${RESET}"
echo ""
